# PostReady AI v10 environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it is already in .gitignore).

# ---------------- Server ----------------
PORT=3000
APP_NAME=PostReady AI
NODE_ENV=development
# Comma-separated list of allowed CORS origins, or `*` for any.
ALLOWED_ORIGINS=*
# Whether chrome-extension://* origins are allowed regardless of ALLOWED_ORIGINS
# (needed because ALLOWED_ORIGINS is exact-string match and can't wildcard
# extension IDs). Default true; set to "false" to disable extension access.
ALLOW_EXTENSION_ORIGIN=true

# ---------------- AI provider ----------------
# Primary provider. Options: mock, openai, gemini, grok, groq
# IMPORTANT: NEVER use `mock` in production — the app refuses to boot.
AI_PROVIDER=openai
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=3

# OpenAI (recommended primary, paid)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (recommended fallback, has a free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Grok — xAI's model (api.x.ai, paid). GROK_API_KEY looks like `xai-...`.
GROK_API_KEY=
GROK_MODEL=grok-4.1-fast

# Groq — groq.com's fast-inference cloud (free tier available). Easy to
# confuse with "Grok" above — different company/API. GROQ_API_KEY looks
# like `gsk_...`. Good zero-cost option if you don't have OpenAI/Gemini keys:
#   AI_PROVIDER=groq
#   GROQ_API_KEY=gsk_...
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------- Supabase (Auth + Database) ----------------
# Create a free project at https://supabase.com
# Dashboard → Project Settings → API → Copy URL + anon key + service_role key
# Required in every environment (localhost, Render) — Supabase Auth is the
# only auth system this app has; there is no fallback. See docs/SUPABASE_SETUP.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- Razorpay ----------------
# Test mode: dashboard.razorpay.com → top-right toggle "Test Mode"
# Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → Add webhook → set URL to https://yourdomain.com/api/razorpay/webhook
# Select events: payment.captured, payment.failed, subscription.activated, subscription.cancelled
# Copy the "Webhook Secret" shown after creation:
RAZORPAY_WEBHOOK_SECRET=

# Optional: Razorpay subscription plan IDs (for recurring billing)
# Create these in Razorpay Dashboard → Subscriptions → Plans
RAZORPAY_PLAN_CREATOR_MONTHLY=
RAZORPAY_PLAN_CREATOR_ANNUAL=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_ANNUAL=
RAZORPAY_PLAN_AGENCY_MONTHLY=
RAZORPAY_PLAN_AGENCY_ANNUAL=

# ---------------- Google OAuth ("Continue with Google") ----------------
# Google OAuth is configured entirely in the Supabase Dashboard
# (Authentication -> Providers -> Google), NOT here — the frontend calls
# supabase.auth.signInWithOAuth() directly and Supabase handles the rest.
# See docs/GOOGLE_SETUP.md for the full walkthrough.

# URL of the deployed frontend. Not required by the backend for auth
# anymore (Supabase redirects straight to the frontend), but still used
# by a few other places (e.g. links in emails). No trailing slash.
FRONTEND_URL=http://localhost:3001

# ---------------- Sentry (optional, recommended for production) ----------------
SENTRY_DSN=
