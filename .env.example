# PostReady AI v10 environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it is already in .gitignore).

# ---------------- Server ----------------
PORT=3000
APP_NAME=PostReady AI
NODE_ENV=development
# Comma-separated list of allowed CORS origins, or `*` for any.
ALLOWED_ORIGINS=*
# Whether chrome-extension://* origins are allowed regardless of ALLOWED_ORIGINS
# (needed because ALLOWED_ORIGINS is exact-string match and can't wildcard
# extension IDs). Default true; set to "false" to disable extension access.
ALLOW_EXTENSION_ORIGIN=true
# Generate a strong random string (32+ chars). PowerShell:
#   [System.Guid]::NewGuid().ToString() + [System.Guid]::NewGuid().ToString()
SESSION_SECRET=change-this-to-a-long-random-string

# ---------------- AI provider ----------------
# Primary provider. Options: mock, openai, gemini, grok
# IMPORTANT: NEVER use `mock` in production — the app refuses to boot.
AI_PROVIDER=openai
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=3

# OpenAI (recommended primary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (recommended fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Grok (optional — not recommended as primary)
GROK_API_KEY=
GROK_MODEL=grok-4.1-fast

# ---------------- Supabase ----------------
# Create a free project at https://supabase.com
# Dashboard → Project Settings → API → Copy URL + anon key + service_role key
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- Razorpay ----------------
# Test mode: dashboard.razorpay.com → top-right toggle "Test Mode"
# Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → Add webhook → set URL to https://yourdomain.com/api/razorpay/webhook
# Select events: payment.captured, payment.failed, subscription.activated, subscription.cancelled
# Copy the "Webhook Secret" shown after creation:
RAZORPAY_WEBHOOK_SECRET=

# Optional: Razorpay subscription plan IDs (for recurring billing)
# Create these in Razorpay Dashboard → Subscriptions → Plans
RAZORPAY_PLAN_CREATOR_MONTHLY=
RAZORPAY_PLAN_CREATOR_ANNUAL=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_ANNUAL=
RAZORPAY_PLAN_AGENCY_MONTHLY=
RAZORPAY_PLAN_AGENCY_ANNUAL=

# ---------------- Google OAuth (optional — "Continue with Google") ----------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
#
# Dev: the redirect URI points at the Vite dev server origin (which proxies
# /api/* to this backend, see frontend/vite.config.ts), so the OAuth callback
# cookie stays same-origin with later /api/me calls made from :3001.
#   Authorized redirect URI (dev): http://localhost:3001/api/auth/google/callback
#
# Prod: the frontend calls this backend directly via VITE_API_URL (no proxy —
# see frontend/src/lib/api.ts), so the redirect URI points at THIS backend's
# own domain instead. Cross-site cookie delivery back to the Vercel frontend
# works because the session cookie is set with SameSite=None; Secure when
# NODE_ENV=production (see COOKIE_OPTIONS in controllers/auth-controller.js
# and controllers/google-auth-controller.js).
#   Authorized redirect URI (prod): https://your-backend.onrender.com/api/auth/google/callback
# See docs/GOOGLE_AUTH_SETUP.md for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# URL of the deployed frontend (React/Vite app). The backend redirects here after
# Google login succeeds or fails. No trailing slash.
FRONTEND_URL=http://localhost:3001

# ---------------- Sentry (optional, recommended for production) ----------------
SENTRY_DSN=
