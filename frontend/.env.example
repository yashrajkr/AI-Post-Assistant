# Frontend environment variables (Vite).
# Copy this file to `.env.local` and edit as needed.
#
# In development, Vite proxies /api → http://localhost:3000 (see vite.config.ts),
# so you can usually leave VITE_API_URL empty. The browser will hit /api/...
# on its own origin and Vite will forward the request to the Express backend.
#
# In production, set VITE_API_URL to the public backend URL
# (e.g. https://api.aipostassistant.com) if frontend + backend are on
# different origins.

VITE_API_URL=
